# Public site runtime config. NEXT_PUBLIC_* are baked at build time.
#
# 双站变体:NEXT_PUBLIC_SITE=palium|palimesh 由 package.json 的 build:*/start:*/dev:* 脚本注入,
# 不要写进 .env.local(同一台机同一目录同时跑两个站,写死会让两个进程读到同一变体)。
#   npm run build            # 两个变体各自输出到 .next-palium / .next-palimesh
#   npm run start:palium     # palium.io   → 127.0.0.1:3004
#   npm run start:palimesh   # palimesh.io → 127.0.0.1:3001
#
# metadataBase 取 site.apex,不再需要 NEXT_PUBLIC_SITE_URL。
# 链基础设施只有一条链(88780);rpc.palium.io + /ws 由 nginx 代理到本地节点 28780 / 28790。
NEXT_PUBLIC_RPC_URL=https://rpc.palium.io
NEXT_PUBLIC_WS_URL=wss://rpc.palium.io/ws
PALI_RPC_URL=https://rpc.palium.io
