{
  "name": "palium-palimesh-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:palimesh",
    "dev:palium": "NEXT_PUBLIC_SITE=palium next dev -p 3004",
    "dev:palimesh": "NEXT_PUBLIC_SITE=palimesh next dev -p 3001",
    "build": "npm run build:palium && npm run build:palimesh",
    "prebuild:palium": "npm run check:i18n",
    "build:palium": "NEXT_PUBLIC_SITE=palium next build",
    "prebuild:palimesh": "npm run check:i18n",
    "build:palimesh": "NEXT_PUBLIC_SITE=palimesh next build",
    "start": "npm run start:palimesh",
    "start:palium": "NEXT_PUBLIC_SITE=palium next start -p 3004",
    "start:palimesh": "NEXT_PUBLIC_SITE=palimesh next start -p 3001",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "smoke": "node scripts/smoke-variants.mjs",
    "lint": "next lint"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "ethers": "^6.13.4",
    "next": "15.5.18",
    "next-intl": "4.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
