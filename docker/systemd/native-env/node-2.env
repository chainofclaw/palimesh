# Phase N1 — systemd EnvironmentFile for native validator instance 2.
# Deployed to /etc/palimesh/node-2.env (referenced by palimesh-node@2.service).

PALI_DATA_DIR=/var/lib/coc/node-2
PALI_NODE_CONFIG=/etc/palimesh/node-2.json
# Replace with this validator's private key during deployment.
PALI_NODE_KEY=REPLACE_WITH_NODE_2_PRIVATE_KEY

# Port bundle: identical to current docker host-side mapping
# (28782/28783/29782/29783/9102). Node-2 has no IPFS HTTP exposure today
# (compose only maps 5001 on node-1 → 28786); we leave PALI_IPFS_PORT
# unset so the daemon binds the default 5001 internally without claiming
# a host-visible port.
PALI_RPC_BIND=0.0.0.0
PALI_RPC_PORT=28782
PALI_WS_BIND=0.0.0.0
PALI_WS_PORT=28783
PALI_P2P_BIND=0.0.0.0
PALI_P2P_PORT=29782
PALI_WIRE_BIND=0.0.0.0
PALI_WIRE_PORT=29783
PALI_METRICS_PORT=9102

PALI_DEV_RELAXED_QUORUM=1
PALI_BFT_AUTO_RECOVERY=1
PALI_DIAG_SPEC_ROOT=0

PALI_NODE_MODE=archive
PALI_IPFS_PORT=5002
PALI_IPFS_BIND=127.0.0.1
