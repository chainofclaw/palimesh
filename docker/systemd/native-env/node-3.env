# Phase N1 — systemd EnvironmentFile for native validator instance 3.
# Deployed to /etc/palimesh/node-3.env (referenced by palimesh-node@3.service).

PALI_DATA_DIR=/var/lib/coc/node-3
PALI_NODE_CONFIG=/etc/palimesh/node-3.json
# Replace with this validator's private key during deployment.
PALI_NODE_KEY=REPLACE_WITH_NODE_3_PRIVATE_KEY

# Port bundle: identical to current docker host-side mapping
# (28784/28785/29784/29785/9103). Same IPFS-port note as node-2.
PALI_RPC_BIND=0.0.0.0
PALI_RPC_PORT=28784
PALI_WS_BIND=0.0.0.0
PALI_WS_PORT=28785
PALI_P2P_BIND=0.0.0.0
PALI_P2P_PORT=29784
PALI_WIRE_BIND=0.0.0.0
PALI_WIRE_PORT=29785
PALI_METRICS_PORT=9103

PALI_DEV_RELAXED_QUORUM=1
PALI_BFT_AUTO_RECOVERY=1
PALI_DIAG_SPEC_ROOT=0

PALI_NODE_MODE=archive
PALI_IPFS_PORT=5003
PALI_IPFS_BIND=127.0.0.1
