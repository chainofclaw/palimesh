# Multi-server testnet — ENV template for ONE validator per host.
# Generated by scripts/deploy-validator-server.sh from this template.
# Placeholders __INSTANCE__, __NODE_KEY__, __*_PORT__ are filled at deploy time.

PALI_DATA_DIR=/var/lib/coc/node-__INSTANCE__
PALI_NODE_CONFIG=/etc/palimesh/node-__INSTANCE__.json
PALI_NODE_KEY=__NODE_KEY__

# Single-validator-per-host port bundle. May be shifted (e.g. +10000) when
# a host is co-located with another Palimesh instance to avoid conflicts.
PALI_RPC_BIND=0.0.0.0
PALI_RPC_PORT=__RPC_PORT__
PALI_WS_BIND=0.0.0.0
PALI_WS_PORT=__WS_PORT__
PALI_P2P_BIND=0.0.0.0
PALI_P2P_PORT=__P2P_PORT__
PALI_WIRE_BIND=0.0.0.0
PALI_WIRE_PORT=__WIRE_PORT__
PALI_IPFS_BIND=127.0.0.1
PALI_IPFS_PORT=__IPFS_PORT__
PALI_METRICS_PORT=__METRICS_PORT__

# Production tuning. Relaxed quorum stays on for v1 multi-server testnet —
# revisit once 3-of-3 is provably stable across real network conditions.
PALI_DEV_RELAXED_QUORUM=1
PALI_BFT_AUTO_RECOVERY=1
PALI_DIAG_SPEC_ROOT=0

# Archive mode — multi-server validators are full historical nodes.
PALI_NODE_MODE=archive
