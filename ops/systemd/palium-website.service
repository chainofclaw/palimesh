# /etc/systemd/system/palium-website.service — palium.io (公链站),端口 3004
# 与 palimesh-website.service 同一工作目录、同一 .env.local、同一 SQLite(WAL);构建产物在 .next-palium
[Unit]
Description=Palium public-chain website (Next.js, palium.io)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/coc/website
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/npm run start:palium
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
